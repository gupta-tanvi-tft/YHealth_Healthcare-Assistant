# Gemini API Key & Model Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore
PORT=8008

# Patient/persona API. API 1 roster ID is separate from the websocket doctor ID.
PATIENTS_API_BASE_URL=http://200.97.162.162:8000/agent/patients
DEFAULT_DOCTOR_ID=YOUR_DOCTOR_ID
PATIENTS_API_DOCTOR_ID=YOUR_DOCTOR_ID
PERSONA_API_BASE_URL=http://200.97.162.162:8000/persona-hardware
PERSONA_HARDWARE_TOKEN=replace_with_current_hardware_token
API1_REQUEST_TIMEOUT_S=35
API2_REQUEST_TIMEOUT_S=8
PATIENT_LOOKUP_TIMEOUT_S=45
GEMINI_NO_PROGRESS_TIMEOUT_S=20
PLAYBACK_MAX_LEAD_S=0.6
PLAYBACK_TARGET_LEAD_S=0.3
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TLS=false
REDIS_KEY_PREFIX=yhealth-assistant
REDIS_ROSTER_TTL_S=86400
REDIS_SESSION_TTL_S=1800
REDIS_PENDING_TTL_S=180
REDIS_PERSONA_MAP_TTL_S=86400
PERSONA_ID_FALLBACK_TO_ROSTER_ID=true

# Edge TTS Configuration - Natural Human Voice
TTS_VOICE=en-US-AvaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

